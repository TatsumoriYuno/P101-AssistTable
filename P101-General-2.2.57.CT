            <CheatEntry>
              <ID>5835</ID>
              <Description>"FreeCam"</Description>
              <Options moHideChildren="1" moActivateChildrenAsWell="1" moDeactivateChildrenAsWell="1"/>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>//-- Speed Modifier for camera movement
globalalloc(speedModifier, 10)
speedModifier:
dd (float)10

{$lua}
KILL_TIMER = false

--local shouldAlternate = false --related to facing direction math

function listen_for_user_input()

--print(getAddressList().getMemoryRecordByDescription('potential camera yaw').CurrentAddress)

local yaw = readFloat(getAddressList().getMemoryRecordByDescription('Character camera yaw').CurrentAddress) --Horizontal (Yaw)
local pitch = readFloat(getAddressList().getMemoryRecordByDescription('potential camera pitch').CurrentAddress) --Vertical (Pitch)


--sine and cosine of rotation values
local siny = math.sin(yaw)  --Sine of Horizontal (yaw)
local cosy = math.cos(yaw)  --Cosine of Horizontal (yaw)
local sinp = math.sin(pitch) --Sine of Vertical (pitch)
local cosp = math.cos(pitch) --Cosine of Vertical (pitch)

local player_x = getAddressList().getMemoryRecordByDescription('Scene Camera X') --Cam X
local player_y = getAddressList().getMemoryRecordByDescription('Scene Camera Y') --Cam Y
local player_z = getAddressList().getMemoryRecordByDescription('Scene Camera Z') --Cam Z


--local increment_val = 20.0 -- previous value: 20.0
local increment_val = readFloat("speedModifier")

--move on x axis controls

--Forward
if(isKeyPressed(VK_NUMPAD8)) then
   --writeFloat(player_x.CurrentAddress, player_x.value + increment_val)  --original code
   writeFloat(player_y.CurrentAddress, player_y.value - (cosy * increment_val))
   writeFloat(player_x.CurrentAddress, player_x.value - (siny * increment_val))
   writeFloat(player_z.CurrentAddress, player_z.value - (sinp * increment_val))
end
--Backward
if(isKeyPressed(VK_NUMPAD2)) then
   --writeFloat(player_x.CurrentAddress, player_x.value - increment_val)
   writeFloat(player_y.CurrentAddress, player_y.value + (cosy * increment_val))
   writeFloat(player_x.CurrentAddress, player_x.value + (siny * increment_val))
   writeFloat(player_z.CurrentAddress, player_z.value + (sinp * increment_val))
end

--move on y axis controls

--Left
if(isKeyPressed(VK_NUMPAD4)) then
   --writeFloat(player_y.CurrentAddress, player_y.value + increment_val)
   writeFloat(player_y.CurrentAddress, player_y.value + (math.cos(yaw + math.rad(90)) * increment_val))
   writeFloat(player_x.CurrentAddress, player_x.value + (math.sin(yaw + math.rad(90)) * increment_val))
end
--Right
if(isKeyPressed(VK_NUMPAD6)) then
   --writeFloat(player_y.CurrentAddress, player_y.value - increment_val)
   writeFloat(player_y.CurrentAddress, player_y.value + (math.cos(yaw - math.rad(90)) * increment_val))
   writeFloat(player_x.CurrentAddress, player_x.value + (math.sin(yaw - math.rad(90)) * increment_val))
end

--Up
if(isKeyPressed(VK_SUBTRACT)) then
writeFloat(player_z.CurrentAddress, player_z.value + increment_val)
end
--Down
if(isKeyPressed(VK_ADD)) then
writeFloat(player_z.CurrentAddress, player_z.value - increment_val)
end

--Speed Modifier
if (isKeyPressed(VK_NUMPAD1)) then
   writeFloat("speedModifier", 500)
else -- if nothing is pressed, speed is normal
   writeFloat("speedModifier", 10)
end
end --end of listen_to_user_input function



function enableTimer()
    timer = createTimer(nil, true)
    timer.Interval = 1
    timer.OnTimer = function(timer)
    if KILL_TIMER == true then
        timer.destroy()
        --print("Timer destroyed")
    else
        listen_for_user_input()
        end
    end
end
[ENABLE]
enableTimer()
[DISABLE]

KILL_TIMER = true
</AssemblerScript>
              <CheatEntries>
                <CheatEntry>
                  <ID>5999</ID>
                  <Description>"Detach Camera"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

assert("Pirate.exe"+9D8335,66 0F D6 00 89 48 08 5E 83 C4 0C) //we use "assert" instead of AOB scan
// -- Disable XY writes to decouple camera from player
"Pirate.exe"+9D8335:
  db 90 90 90 90 90 90 90  // the number of NOP bytes here, must match the one below under [DISABLE]

// -- Disable Z writes to decouple camera from player
"Pirate.exe"+9D8339:
  db 90 90 90

[DISABLE]
"Pirate.exe"+9D8335:
  db 66 0F D6 00 89 48 08

"Pirate.exe"+9D8339:
  db 89 48 08

{
// ORIGINAL CODE - INJECTION POINT: Pirate.exe+9DA2D5

Pirate.exe+9DA2A5: 8B 87 A8 00 00 00  - mov eax,[edi+000000A8]
Pirate.exe+9DA2AB: F3 0F 10 4E 04     - movss xmm1,[esi+04]
Pirate.exe+9DA2B0: F3 0F 10 56 08     - movss xmm2,[esi+08]
Pirate.exe+9DA2B5: 83 C0 54           - add eax,54
Pirate.exe+9DA2B8: F3 0F 11 44 24 08  - movss [esp+08],xmm0
Pirate.exe+9DA2BE: F3 0F 11 4C 24 0C  - movss [esp+0C],xmm1
Pirate.exe+9DA2C4: F3 0F 7E 44 24 08  - movq xmm0,[esp+08]
Pirate.exe+9DA2CA: F3 0F 11 54 24 10  - movss [esp+10],xmm2
Pirate.exe+9DA2D0: 8B 4C 24 10        - mov ecx,[esp+10]
Pirate.exe+9DA2D4: 5F                 - pop edi
// ---------- XY START ----------
Pirate.exe+9DA2D5: 66 0F D6 00        - movq [eax],xmm0      //-- use this line's module name + offset and...
// ---------- XY END ----------
// ---------- Z START ----------
Pirate.exe+9DA2D9: 89 48 08           - mov [eax+08],ecx     // thsi line's module name + offset EVERY UPDATE
// ---------- Z END ----------
Pirate.exe+9DA2DC: 5E                 - pop esi
Pirate.exe+9DA2DD: 83 C4 0C           - add esp,0C
Pirate.exe+9DA2E0: C2 04 00           - ret 0004
Pirate.exe+9DA2E3: CC                 - int 3 
Pirate.exe+9DA2E4: CC                 - int 3 
Pirate.exe+9DA2E5: CC                 - int 3 
Pirate.exe+9DA2E6: CC                 - int 3 
Pirate.exe+9DA2E7: CC                 - int 3 
Pirate.exe+9DA2E8: CC                 - int 3


Here is the AOB scan code I used on the next update:

8B 87 A8000000 xx xx xx xx 04
}
</AssemblerScript>
                </CheatEntry>
                <CheatEntry>
                  <ID>6001</ID>
                  <Description>"Detach Camera Pitch"</Description>
                  <VariableType>Auto Assembler Script</VariableType>
                  <AssemblerScript>[ENABLE]

assert("Pirate.exe"+960E5C,D9 86 74 01 00 00 D9)
//-- Disable Pitch writes to decouple camera from player
"Pirate.exe"+960E5C:
  db 90 90 90 90 90 90


[DISABLE]

"Pirate.exe"+960E5C:
  db D9 86 74 01 00 00


{
// ORIGINAL CODE - INJECTION POINT: Pirate.exe+962AAC

Pirate.exe+962A7E: F3 0F 11 44 24 18        - movss [esp+18],xmm0
Pirate.exe+962A84: F3 0F 10 05 74 01 42 02  - movss xmm0,[Pirate.exe+2020174]
Pirate.exe+962A8C: 0F 5A D0                 - cvtps2pd xmm2,xmm0
Pirate.exe+962A8F: 66 0F 2F CA              - comisd xmm1,xmm2
Pirate.exe+962A93: 76 06                    - jna Pirate.exe+962A9B
Pirate.exe+962A95: F3 0F 11 44 24 18        - movss [esp+18],xmm0
Pirate.exe+962A9B: D9 44 24 18              - fld dword ptr [esp+18]
Pirate.exe+962A9F: 83 EC 0C                 - sub esp,0C
Pirate.exe+962AA2: D9 5C 24 08              - fstp dword ptr [esp+08]
Pirate.exe+962AA6: 8D 8E 50 01 00 00        - lea ecx,[esi+00000150]
// ---------- INJECTING HERE ----------
Pirate.exe+962AAC: D9 86 74 01 00 00        - fld dword ptr [esi+00000174]
// ---------- DONE INJECTING  ----------
Pirate.exe+962AB2: D9 5C 24 04              - fstp dword ptr [esp+04]
Pirate.exe+962AB6: D9 46 48                 - fld dword ptr [esi+48]
Pirate.exe+962AB9: D9 1C 24                 - fstp dword ptr [esp]
Pirate.exe+962ABC: E8 7F E3 FF FF           - call Pirate.exe+960E40
Pirate.exe+962AC1: 80 BE E0 01 00 00 00     - cmp byte ptr [esi+000001E0],00
Pirate.exe+962AC8: D9 5C 24 18              - fstp dword ptr [esp+18]
Pirate.exe+962ACC: D9 44 24 18              - fld dword ptr [esp+18]
Pirate.exe+962AD0: D9 56 48                 - fst dword ptr [esi+48]
Pirate.exe+962AD3: 75 0B                    - jne Pirate.exe+962AE0
Pirate.exe+962AD5: 0F 57 C0                 - xorps xmm0,xmm0

Here's the AOB scan I used to find this same code NEXT update:

8D 8E 50010000 D9 86 74010000

}
</AssemblerScript>
                </CheatEntry>
              </CheatEntries>
            </CheatEntry>
          </CheatEntries>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
    <CheatEntry>
      <ID>928</ID>
      <Description>"Mission specific teleports"</Description>
      <Options moHideChildren="1"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <ID>6030</ID>
          <Description>"Rooke..."</Description>
          <Options moHideChildren="1"/>
          <GroupHeader>1</GroupHeader>
          <CheatEntries>
            <CheatEntry>
              <ID>6042</ID>
              <Description>"Teleport to Rooke (aside from rooke)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
[ENABLE]
 local player_x_addr = getAddressList().getMemoryRecordByDescription('X').CurrentAddress
local player_y_addr = getAddressList().getMemoryRecordByDescription('Y').CurrentAddress
local player_z_addr = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress
