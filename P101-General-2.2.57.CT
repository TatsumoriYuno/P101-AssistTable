            <CheatEntry>
              <ID>5507</ID>
              <Description>"Teleport to Rooke (inside dungeon, at dungeon start)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
KILL_TIMER = false

function port_to_rooke_beginning()
local player_x_addr = getAddressList().getMemoryRecordByDescription('X').CurrentAddress
local player_y_addr = getAddressList().getMemoryRecordByDescription('Y').CurrentAddress
local player_z_addr = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress

--local player_facingDir_addr = getAddressList().getMemoryRecordByDescription('Facing (Horizontal)').CurrentAddress

--writeFloat(player_facingDir_addr, 1.561848879)
writeFloat(player_x_addr, -1108.515137)
writeFloat(player_y_addr, 1661.954346)
writeFloat(player_z_addr, -291.2753296)
end



function keepTimerGoing(sometimer)
   port_to_rooke()
end

function enableTimer()
    timer = createTimer(nil, true)
    timer.Interval = 3000
    timer.OnTimer = function(timer)
    if KILL_TIMER == true then
        timer.destroy()
        print("Timer destroyed")
    else
        port_to_rooke_beginning()
        end
    end
end

[ENABLE]
enableTimer()
[DISABLE]

KILL_TIMER = true
</AssemblerScript>
