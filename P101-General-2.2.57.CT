        <CheatEntry>
          <ID>6195</ID>
          <Description>"Return Position (For When On Ship)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
[ENABLE]
-- Function to save current coordinates
local function saveCoordinates()
    -- Player's coordinates (on foot)
    local player_x_addr = getAddressList().getMemoryRecordByID(828).CurrentAddress -- x address
    local player_y_addr = getAddressList().getMemoryRecordByID(829).CurrentAddress -- y address
    local player_z_addr = getAddressList().getMemoryRecordByID(830).CurrentAddress -- z address

    -- Ship coordinates
    local ship_x_addr = getAddressList().getMemoryRecordByDescription('Ship X').CurrentAddress
    local ship_y_addr = getAddressList().getMemoryRecordByDescription('Ship Y').CurrentAddress
    local ship_z_addr = getAddressList().getMemoryRecordByDescription('Ship Z').CurrentAddress

    -- Check if we're on a ship, and save the respective coordinates
    if ship_x_addr and ship_y_addr and ship_z_addr then
        -- Save ship coordinates if we are on a ship
        last_x = readFloat(ship_x_addr)
        last_y = readFloat(ship_y_addr)
        last_z = readFloat(ship_z_addr)
    else
        -- Save player coordinates if not on a ship
        last_x = readFloat(player_x_addr)
        last_y = readFloat(player_y_addr)
        last_z = readFloat(player_z_addr)
    end

    -- Debug print to ensure values are being saved
    -- print(string.format("Saved coordinates: X = %.6f, Y = %.6f, Z = %.6f", last_x, last_y, last_z))
end

local function applyJitter()
    -- Move player briefly in one direction (left)
    writeInteger(getAddressList().getMemoryRecordByID(5996).CurrentAddress, 32)  -- Jitter left
    sleep(100)  -- Wait briefly before moving back

    -- Stop jitter
    writeInteger(getAddressList().getMemoryRecordByID(5996).CurrentAddress, 0)
end

-- Function to return to saved coordinates once and clear saved position
local function returnToSavedCoordinates()
    if last_x and last_y and last_z then
        -- Check if the player is on a ship by checking if the 'Ship X' address exists
        local is_on_ship = getAddressList().getMemoryRecordByDescription('Ship X') ~= nil

        if is_on_ship then
            -- Teleport the ship to the saved coordinates
            local ship_x = getAddressList().getMemoryRecordByDescription('Ship X').CurrentAddress
            local ship_y = getAddressList().getMemoryRecordByDescription('Ship Y').CurrentAddress
            local ship_z = getAddressList().getMemoryRecordByDescription('Ship Z').CurrentAddress

            -- Teleport the ship back to the saved coordinates
            writeFloat(ship_x, last_x)
            writeFloat(ship_y, last_y)
            writeFloat(ship_z, last_z)
            --applyJitter()

            -- Debug print to confirm ship teleport
            -- print(string.format("Returning ship to saved coordinates: X = %.6f, Y = %.6f, Z = %.6f", last_x, last_y, last_z))
        else
            -- Teleport the player to the saved coordinates
            local player_x = getAddressList().getMemoryRecordByDescription('X').CurrentAddress
            local player_y = getAddressList().getMemoryRecordByDescription('Y').CurrentAddress
            local player_z = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress

            -- Teleport the player back to the saved coordinates
            writeFloat(player_x, last_x)
            writeFloat(player_y, last_y)
            writeFloat(player_z, last_z)
            --applyJitter()

            -- Debug print to confirm player teleport
            -- print(string.format("Returning player to saved coordinates: X = %.6f, Y = %.6f, Z = %.6f", last_x, last_y, last_z))
        end

        -- Clear the saved coordinates after teleporting
        last_x, last_y, last_z = nil, nil, nil
        -- print("Saved coordinates cleared!")
    else
        print("Error: No saved coordinates found! Saving current position.")
        saveCoordinates()
    end
end

-- Call the function to teleport and clear the saved position after the first teleport
returnToSavedCoordinates()

[DISABLE]
-- No additional code needed

</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>5483</ID>
          <Description>"NoClip"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
KILL_TIMER = false

local shouldAlternate = false --related to facing direction math

function listen_for_user_input()
    local didPlayerInput = false --if player inputted, this will be true

    local player_x = getAddressList().getMemoryRecordByDescription('X')
    local player_y = getAddressList().getMemoryRecordByDescription('Y')
    local player_z = getAddressList().getMemoryRecordByDescription('Z')


    local increment_val = 20.0

--move on x axis controls
    if(isKeyPressed(VK_5)) then
        writeFloat(player_x.CurrentAddress, player_x.value + increment_val)
        didPlayerInput = true
    end
    if(isKeyPressed(VK_6)) then
        writeFloat(player_x.CurrentAddress, player_x.value - increment_val)
        didPlayerInput = true
    end

--move on y axis controls
    if(isKeyPressed(VK_8)) then
        writeFloat(player_y.CurrentAddress, player_y.value + increment_val)
        didPlayerInput = true
    end
    if(isKeyPressed(VK_7)) then
        writeFloat(player_y.CurrentAddress, player_y.value - increment_val)
        didPlayerInput = true
    end

--move on z axis controls
    if(isKeyPressed(VK_9)) then
        writeFloat(player_z.CurrentAddress, player_z.value + increment_val)
        didPlayerInput = true
    end
    if(isKeyPressed(VK_0)) then
        writeFloat(player_z.CurrentAddress, player_z.value - increment_val)
        didPlayerInput = true
    end
--move player IFF playe inputted something...
    if (didPlayerInput == true) then
        local player_movement_addr = getAddressList().getMemoryRecordByID(5996).CurrentAddress --player movement address

        if(shouldAlternate) then
            writeInteger(player_movement_addr, 32) --update player camera by moving after teleport
        else
            --writeInteger(player_movement_addr, 64)
        end
        delay_then_reset_player_movement(player_movement_addr)
        shouldAlternate = not shouldAlternate

    end --end of player movement if statement

end --end of listen_to_user_input function


--helper function to delay an action
function delay_then_reset_player_movement(_player_movement_addr) --function that delays reset of player movement
    timer = createTimer(nil, true)
    timer.Interval = 20 --default was 3000
    timer.OnTimer = function(timer)
        writeInteger(_player_movement_addr, 0)
        timer.destroy()
        --print("Timer destroyed")
    end

end




function enableTimer()
    timer = createTimer(nil, true)
    timer.Interval = 1
    timer.OnTimer = function(timer)
    if KILL_TIMER == true then
        timer.destroy()
    else
        listen_for_user_input()
        end
    end
end

[ENABLE]
enableTimer()

[DISABLE]
KILL_TIMER = true
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>5836</ID>
          <Description>"AFK spin"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
local player_movement_addr_memrecord = getAddressList().getMemoryRecordByID(5996)
local player_movement_addr = getAddressList().getMemoryRecordByID(5996).CurrentAddress --player movement address

function afk_spin() --performs afk spin even when window is unfocused

   writeInteger(player_movement_addr, 32) --32 spins to left, 64 spins to right
   player_movement_addr_memrecord.active = true
end

function undo_afk_spin() --undoes the afk spin
   player_movement_addr_memrecord.active = false
   writeInteger(player_movement_addr, 0) --0 stops all movement
end

[ENABLE]
afk_spin()

[DISABLE]
undo_afk_spin()
</AssemblerScript>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>
