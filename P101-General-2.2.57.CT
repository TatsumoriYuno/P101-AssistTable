            <CheatEntry>
              <ID>6200</ID>
              <Description>"Skull Island Docks TP (From Averys Court)"</Description>
              <VariableType>Auto Assembler Script</VariableType>
              <AssemblerScript>{$lua}
[ENABLE]
-- Get the memory addresses for the player's coordinates (X, Y, Z)
local player_x = getAddressList().getMemoryRecordByDescription('X').CurrentAddress
local player_y = getAddressList().getMemoryRecordByDescription('Y').CurrentAddress
local player_z = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress

-- Function to apply jitter (move player briefly)
local function applyJitter()
    -- Move player briefly in one direction (left)
    writeInteger(getAddressList().getMemoryRecordByID(5996).CurrentAddress, 32)  -- Jitter left
    sleep(100)  -- Wait briefly before moving back

    -- Stop jitter
    writeInteger(getAddressList().getMemoryRecordByID(5996).CurrentAddress, 0)
end

-- Function to teleport the player to the given coordinates
local function teleport(x, y, z)
    writeFloat(player_x, x)
    writeFloat(player_y, y)
    writeFloat(player_z, z)
end

-- Teleport to first position
teleport(977.38336945, 11808.416504, 1630.0001831)

-- Apply jitter immediately after the first teleport
--applyJitter()

-- Wait for loading
sleep(4500)

-- Refetch Coordinates
player_x = getAddressList().getMemoryRecordByDescription('X').CurrentAddress
player_y = getAddressList().getMemoryRecordByDescription('Y').CurrentAddress
player_z = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress

-- Second teleport
teleport(-20.38336945, -157.416504, 161.0001831)

-- Apply jitter again after the second teleport
--applyJitter()

[DISABLE]
-- Ensure the movement is restored
writeInteger(getAddressList().getMemoryRecordByID(5996).CurrentAddress, 0)

</AssemblerScript>
