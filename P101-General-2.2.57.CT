        <CheatEntry>
          <ID>6190</ID>
          <Description>"Coord Grabber"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
[ENABLE]
-- Get the memory addresses for the player's coordinates (X, Y, Z)
local player_x = getAddressList().getMemoryRecordByDescription('X').CurrentAddress
local player_y = getAddressList().getMemoryRecordByDescription('Y').CurrentAddress
local player_z = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress

-- Counter to print 5 times
local print_count = 0

-- Function to print coordinates
local function printCoordinates()
    local x = readFloat(player_x)
    local y = readFloat(player_y)
    local z = readFloat(player_z)
    print(string.format("X = %.6f, Y = %.6f, Z = %.6f", x, y, z))
end

-- Print coordinates 5 times with a 1 second delay between prints
while print_count &lt; 5 do
    printCoordinates()
    print_count = print_count + 1
    sleep(1000)  -- Sleep for 1 second
end

[DISABLE]


</AssemblerScript>
