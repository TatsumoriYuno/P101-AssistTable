local player_z = getAddressList().getMemoryRecordByDescription('Z').CurrentAddress

if not last_x then last_x = nil end
if not last_y then last_y = nil end
if not last_z then last_z = nil end

local function saveCoordinates()
    last_x = readFloat(player_x)
    last_y = readFloat(player_y)
    last_z = readFloat(player_z)
end
saveCoordinates()

-- Function to apply jitter (move player briefly)
